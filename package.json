{
  "name": "cerebro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "docker compose up -d && bun run --filter '*' dev",
    "dev:api": "bun run --filter '@cerebro/api' dev",
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter '@cerebro/db' generate",
    "db:migrate": "bun run --filter '@cerebro/db' migrate",
    "db:seed": "bun run --filter '@cerebro/db' seed",
    "db:reset": "bun run --filter '@cerebro/db' reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.1.14",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
