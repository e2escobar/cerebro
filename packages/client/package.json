{
  "name": "@cerebro/client",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Typed feature flag client for Cerebro \u2014 core, React and Next.js.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cerebro-codegen": "./dist/codegen.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.typing.json",
    "typecheck:dist": "tsc --noEmit -p tsconfig.dist.json",
    "verify:dist": "bun run build && bun run verify:artifacts && bun run typecheck:dist",
    "verify:artifacts": "bun scripts/verify-artifacts.ts",
    "test": "bun test",
    "prepublishOnly": "bun run verify:dist && bun run test"
  },
  "peerDependencies": {
    "next": "^14.2.0 || ^15.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cerebro/tsconfig": "workspace:*",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
